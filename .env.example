# ====================================================================
# VGM SKILL HUB - PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. ENVIRONMENT & SERVER
NODE_ENV="development" # Set to "production" on Render
PORT=3000              # On Render, this is automatically set to 10000
APP_URL="http://localhost:3000"

# 2. LIVE SUPABASE DATABASE (PostgreSQL)
# Get your credentials at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. RAZORPAY PAYMENT GATEWAY
# Test Mode / Live Mode credentials from: https://dashboard.razorpay.com/#/access/api-keys
# Test keys begin with "rzp_test_...", Live keys begin with "rzp_live_..."
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# 4. ADMINISTRATIVE & SESSION SECURITY
# Strong password for /admin dashboard access
ADMIN_PASSWORD="vgm_admin_2026"
# 32+ character random secret used to sign admin session tokens
SESSION_SECRET="vgm_session_secret_change_in_production_9988776655"
ADMIN_TOKEN_EXPIRY_MS=86400000

# 5. RATE LIMITING CONFIGURATION
RATE_LIMIT_AUTH_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5        # Max attempts before exponential backoff
RATE_LIMIT_AUTH_BASE_DELAY_SEC=2      # 2s, 4s, 8s, 16s...
RATE_LIMIT_PUBLIC_WINDOW_MS=60000     # 1 minute
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60     # 60 req/min for public browsing
RATE_LIMIT_API_WINDOW_MS=60000        # 1 minute
RATE_LIMIT_API_MAX_REQUESTS=120       # 120 req/min for orders and student portal

# 6. FILE STORAGE SAFETY
MAX_UPLOAD_SIZE_BYTES=5242880         # 5 MB maximum file upload size

# 7. EMAIL NOTIFICATIONS (Optional SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="intern@vgmsofttech.com"
SMTP_PASS=""
NOTIFICATION_EMAIL="intern@vgmsofttech.com"

# 8. AI ASSISTANT / GEMINI API (Optional)
GEMINI_API_KEY=""
