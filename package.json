{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx API/server.ts",
    "dev:admin": "vite --config Adminweb/vite.config.ts",
    "start": "node server.js",
    "build:frontend": "vite build",
    "build:admin": "vite build --config Adminweb/vite.config.ts",
    "build:server": "esbuild API/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server.js",
    "build": "vite build && vite build --config Adminweb/vite.config.ts && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-admin server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/gsap": "^1.20.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
